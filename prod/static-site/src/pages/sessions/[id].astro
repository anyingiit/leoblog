---
import Layout from "../../layouts/Layout.astro"; import { getSnapshot } from "../../lib/content.mjs"; const site = getSnapshot(); export function getStaticPaths() { return getSnapshot().approved.filter((item) => item.kind === "session").map((item) => ({ params: { id: String(item.id) }, props: { item } })); } const { item } = Astro.props;
---
<Layout title={item.data.title || item.id}><h1>{item.data.title || item.id}</h1><p>{item.data.summary}</p></Layout>
