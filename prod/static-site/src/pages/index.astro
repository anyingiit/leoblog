---
import Layout from "../layouts/Layout.astro";
import { getSnapshot } from "../lib/content.mjs";
const site = getSnapshot();
---
<Layout title="Leoblog"><h1>Leoblog</h1><p class="muted">A reviewed public publication.</p><h2>Posts</h2>{site.posts.map((post) => <article class="card"><h3><a href={`/posts/${post.slug}`}>{post.title}</a></h3><p>{post.summary}</p></article>)}</Layout>
