---
const { title } = Astro.props;
const marker = import.meta.env.LEOBLOG_VERSION_MARKER;
if (!/^[0-9a-f]{64}$/.test(marker ?? "")) throw new Error("A valid Leoblog version marker is required");
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="leoblog-version" content={marker} /><title>{title}</title><style>:root{font-family:system-ui,sans-serif;color:#1d2939;background:#f7f8fa}body{max-width:900px;margin:auto;padding:1rem 1.25rem;line-height:1.6}nav{display:flex;gap:1rem;border-bottom:1px solid #d0d5dd;padding:.5rem 0 1rem;margin-bottom:2rem}a{color:#175cd3}.card{background:white;border:1px solid #eaecf0;border-radius:8px;padding:1rem;margin:1rem 0}.muted{color:#667085}pre{overflow:auto;background:#101828;color:#f2f4f7;padding:1rem;border-radius:6px}</style></head><body><nav><a href="/">Leoblog</a><a href="/timeline">Timeline</a><a href="/sessions">Sessions</a><a href="/archive">Archive</a></nav><main><slot /></main></body></html>
